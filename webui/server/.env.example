# ==== DataFlow-EDU WebUI Server 环境变量样例 ====
# 复制为 webui/server/.env 后再修改。
# .env 已纳入 .gitignore，禁止提交真实凭据。

# 运行模式：production | development（本地调 API 用 npm run dev 时脚本会固定为 development，避免 .env 里写 production 导致 CORS 拒绝 localhost）
NODE_ENV=production

# JWT 签名密钥（生产环境必须为 ≥32 字节的强随机串，否则服务将拒绝启动）
# 生成方式：node -e "console.log(require('crypto').randomBytes(40).toString('hex'))"
JWT_SECRET=

# CORS 允许的前端 origin（逗号分隔，生产填真实域名；开发模式自动追加 localhost:5173）
CORS_ORIGINS=https://dataflow-edu.site,https://www.dataflow-edu.site

# 首次启动自动 seed 的管理员账号
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 上传与配额
MAX_UPLOAD_MB=50
DAILY_UPLOAD_LIMIT=20

# 服务端口
PORT=3000

# Python 解释器（可执行路径或解释器名；空则默认 python）
PYTHON_BIN=

# ZGCA 平台 LLM Key（供应商锁定为 ZGCA 时服务端直接注入，无需用户 BYOK）
LLM_ZGCA_API_KEY=
# New API 部分部署计费接口要求附带控制台用户 ID（与 sk 令牌配合）；不需要则留空
LLM_ZGCA_NEW_API_USER=
