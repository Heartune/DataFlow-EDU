# ==== DataFlow-EDU WebUI Server 环境变量样例 ====
# 复制为 webui/server/.env 后再修改。
# .env 已纳入 .gitignore，禁止提交真实凭据。

# JWT 签名密钥（生产环境务必改成 32+ 字符的强随机串）
JWT_SECRET=

# 首次启动自动 seed 的管理员账号
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 上传与配额
MAX_UPLOAD_MB=
DAILY_UPLOAD_LIMIT=

# 服务端口
PORT=

# Python 解释器（可执行路径或解释器名；空则默认 python）
PYTHON_BIN=